# Merge these routes into the existing site. Only the public listener is proxied.
# Set GROUPS_PUBLIC_URL to the same public URL, without a trailing slash.
wecli.net {
    redir /groups /groups/ 308
    handle_path /groups/* {
        reverse_proxy 127.0.0.1:51310 {
            flush_interval -1
        }
    }
    # Keep the site's other existing routes here.
}
