# Merge into the existing wecli.net site. Keep its other routes.
wecli.net {
    @hub path /hub /hub/*
    handle @hub {
        reverse_proxy 127.0.0.1:51211
    }
    redir /groups /groups/ 308
    handle_path /groups/* {
        reverse_proxy 127.0.0.1:51310 {
            flush_interval -1
        }
    }
    # Keep the original site fallback here. Do not proxy port 51311.
}
