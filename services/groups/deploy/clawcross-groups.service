[Unit]
Description=ClawCross Groups website and relay
After=network.target

[Service]
Type=simple
User=clawcross-groups
WorkingDirectory=/opt/clawcross-groups
EnvironmentFile=/etc/clawcross-groups.env
ExecStart=/opt/clawcross-groups/.venv/bin/clawcross-groups
StateDirectory=clawcross-groups
Restart=on-failure
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
